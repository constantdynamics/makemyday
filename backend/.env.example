# Server
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database
POSTGRES_URL=postgresql://makemyday:makemyday_dev_password@localhost:5432/makemyday
MONGODB_URL=mongodb://makemyday:makemyday_dev_password@localhost:27017/makemyday?authSource=admin
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# External APIs
MAPBOX_ACCESS_TOKEN=your-mapbox-token
OSRM_API_URL=https://router.project-osrm.org
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Azure Translator (optional)
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# AWS S3 (for photo storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
AWS_S3_BUCKET=makemyday-photos

# Rate Limiting
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
