{
  "name": "makemyday",
  "version": "1.0.0",
  "description": "Make My Day - Discover surprising experiences in your area",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "scripts": {
    "backend": "npm run dev --workspace=backend",
    "frontend": "npm start --workspace=frontend",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "test": "npm test --workspaces",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
