{
  "name": "makemyday",
  "version": "2.0.0",
  "description": "Make My Day — laat het toeval je dag maken. Ontdek spontane avonturen bij jou in de buurt.",
  "private": true,
  "scripts": {
    "dev": "npm run dev --prefix web",
    "build": "npm run build --prefix web",
    "preview": "npm run preview --prefix web",
    "deploy": "npm run deploy --prefix web",
    "setup": "bash scripts/setup.sh",
    "format": "prettier --write \"web/src/**/*.{ts,tsx,css,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.2.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}
